# Server
PORT=3000

# Stellar network: testnet (default) or mainnet
NETWORK=testnet

# Horizon URL (defaults to testnet if not set)
# HORIZON_URL=https://horizon-testnet.stellar.org

# Allowed CORS origin(s) (defaults to "*"; set to your frontend's origin in production)
# Accepts a single origin or a comma-separated list
# CORS_ORIGIN=https://app.example.com,https://staging.example.com

# API rate limiting (per IP, applied to all /api routes)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60
