# Server
PORT=3000

# Log level: debug | info (default) | warn | error
# LOG_LEVEL=info

# Stellar network: testnet (default) or mainnet
NETWORK=testnet

# Horizon URL (defaults to the Horizon instance matching NETWORK if not set:
# testnet -> https://horizon-testnet.stellar.org, mainnet -> https://horizon.stellar.org)
# HORIZON_URL=https://horizon-testnet.stellar.org

# Allowed CORS origin(s) (defaults to "*"; set to your frontend's origin in production)
# Accepts a single origin or a comma-separated list
# CORS_ORIGIN=https://app.example.com,https://staging.example.com

# API rate limiting (per IP, applied to all /api routes)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# Stream persistence: "memory" (default, lost on restart) or "file"
# STREAM_STORE=file
# STREAM_STORE_PATH=./data/streams.json

# Max time to wait for in-flight requests during shutdown before forcing exit
# SHUTDOWN_TIMEOUT_MS=10000
